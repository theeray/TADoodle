rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function pollData(pollId) { return get(/databases/$(database)/documents/polls/$(pollId)).data; }
    function nonblank(value, maximum) {
      return value is string && value.size() > 0 && value.size() <= maximum && value.matches('.*\\S.*');
    }
    match /polls/{pollId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['title','description','organizerName','ownerUid','timezone','duration','slotIds','status','selectedStart','schemaVersion','createdAt'])
        && request.resource.data.keys().hasAll(['title','description','organizerName','ownerUid','timezone','duration','slotIds','status','selectedStart','schemaVersion','createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && nonblank(request.resource.data.title, 100)
        && nonblank(request.resource.data.organizerName, 60)
        && request.resource.data.description is string && request.resource.data.description.size() <= 600
        && nonblank(request.resource.data.timezone, 80)
        && request.resource.data.duration in [30,60,90,120]
        && request.resource.data.slotIds is list
        && request.resource.data.slotIds.size() > 0 && request.resource.data.slotIds.size() <= 672
        && request.resource.data.slotIds.toSet().size() == request.resource.data.slotIds.size()
        && request.resource.data.status == 'open'
        && request.resource.data.selectedStart == ''
        && request.resource.data.schemaVersion in [1,2]
        && request.resource.data.createdAt == request.time;
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','selectedStart','title'])
        && nonblank(request.resource.data.title, 100)
        && ((request.resource.data.status == 'open' && request.resource.data.selectedStart == '')
          || (request.resource.data.status == 'closed'
            && request.resource.data.selectedStart in resource.data.slotIds));
      allow delete: if false;
      // Imported availability is an immutable baseline, never a participant submission.
      match /copiedResponses/{uid} {
        allow read: if signedIn() && exists(/databases/$(database)/documents/polls/$(pollId));
        allow create: if signedIn()
          && !exists(/databases/$(database)/documents/polls/$(pollId))
          && getAfter(/databases/$(database)/documents/polls/$(pollId)).data.ownerUid == request.auth.uid
          && getAfter(/databases/$(database)/documents/polls/$(pollId)).data.schemaVersion == 2
          && request.resource.data.keys().hasOnly(['name','available','ifNeeded','updatedAt'])
          && nonblank(request.resource.data.name, 60)
          && request.resource.data.available is list && request.resource.data.ifNeeded is list
          && request.resource.data.available.size() <= 672 && request.resource.data.ifNeeded.size() <= 672
          && request.resource.data.available.toSet().size() == request.resource.data.available.size()
          && request.resource.data.ifNeeded.toSet().size() == request.resource.data.ifNeeded.size()
          && request.resource.data.available.hasOnly(getAfter(/databases/$(database)/documents/polls/$(pollId)).data.slotIds)
          && request.resource.data.ifNeeded.hasOnly(getAfter(/databases/$(database)/documents/polls/$(pollId)).data.slotIds)
          && !request.resource.data.available.hasAny(request.resource.data.ifNeeded)
          && request.resource.data.updatedAt == request.time;
        allow update, delete: if false;
      }
      match /responses/{uid} {
        allow read: if signedIn() && exists(/databases/$(database)/documents/polls/$(pollId));
        allow create, update: if signedIn() && request.auth.uid == uid
          && pollData(pollId).status == 'open'
          && request.resource.data.keys().hasOnly(['name','available','ifNeeded','updatedAt'])
          && request.resource.data.keys().hasAll(['name','available','ifNeeded','updatedAt'])
          && nonblank(request.resource.data.name, 60)
          && request.resource.data.available is list && request.resource.data.ifNeeded is list
          && request.resource.data.available.size() <= 672 && request.resource.data.ifNeeded.size() <= 672
          && request.resource.data.available.toSet().size() == request.resource.data.available.size()
          && request.resource.data.ifNeeded.toSet().size() == request.resource.data.ifNeeded.size()
          && request.resource.data.available.hasOnly(pollData(pollId).slotIds)
          && request.resource.data.ifNeeded.hasOnly(pollData(pollId).slotIds)
          && !request.resource.data.available.hasAny(request.resource.data.ifNeeded)
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }
    }
  }
}
