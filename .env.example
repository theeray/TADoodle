# Public Firebase web-app configuration. These are not server secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Optional reCAPTCHA v3 public site key. Enable Firebase App Check enforcement
# only after verifying requests carry valid tokens from your deployed host.
VITE_RECAPTCHA_SITE_KEY=
